# ============================================================
# deadman 平台 Docker 构建忽略清单
#
# 设计原则：
#   - 排除版本控制、Python 缓存、测试、密钥等非运行时必需文件
#   - 保留运行时 MCP Server 依赖的 rules/ agents/ knowledge/ skills/ 下的 .md
#   - 保留 README.md（pip 安装时 pyproject.toml 的 readme 字段需要）
# ============================================================

# === 版本控制 ===
.git
.gitignore
.gitattributes

# === Python 缓存与构建产物 ===
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/
wheels/

# === 测试与覆盖率 ===
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
# 排除测试套件（eval 模式需挂载卷注入 tests/）
src/src/tests/
src/tests/

# === Markdown 文档 ===
# 排除所有 .md，但保留 README.md 以及运行时 MCP 工具依赖的 rules/agents/knowledge/skills 下的 .md
**/*.md
!**/README.md
!src/rules/**
!src/agents/**
!src/knowledge/**
!src/skills/**

# === 密钥与敏感文件（绝不进镜像）===
.env
.env.*
*.key
*.pem
*.p12
secrets/
credentials/
credentials.json
**/credentials*

# === IDE 与编辑器 ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# === 数据与运行时产物 ===
data/
*.db
*.sqlite3
*.log
logs/
runtime/
tmp/
langfuse_exports/
otel_exports/
trace_exports/
lightrag_storage/
graphiti_storage/
neo4j_data/

# === 虚拟环境 ===
venv/
.venv/
env/
ENV/

# === 本地配置覆盖 ===
config.local.*
*.local.yaml
*.local.yml
*.local.json

# === Docker 自身（避免循环引用与上下文膨胀）===
Dockerfile
docker-compose.yml
.dockerignore

# === 其他 ===
sync.sh
src/.placeholder
