# ============================================================
# deadman 平台环境变量示例
#
# 用法：cp .env.example .env，填入真实值后 docker compose up
# 注意：.env 已在 .gitignore 中，绝不会入仓库
# ============================================================

# === 版本（镜像 tag）===
DEADMAN_VERSION=5.1.0

# === LLM（必填）===
# provider 可选：openai / anthropic / zhipu / qwen / deepseek / ernie / newapi / ollama / vllm
#   - newapi：聚合网关（OpenAI 兼容，多厂商模型 auto/DeepSeek-V4-*/glm-5.*），适合国内网络
LLM_PROVIDER=newapi
LLM_MODEL=auto
LLM_API_KEY=sk-xxx
LLM_BASE_URL=
LLM_TIMEOUT=30

# === LLM Fallback 链（主 LLM 失败时按序尝试，逗号分隔 provider:model）===
# 每个 provider 的 key 从对应环境变量读取
#   （OPENAI_API_KEY / ANTHROPIC_API_KEY / ZHIPU_API_KEY
#    / DASHSCOPE_API_KEY(通义千问) / DEEPSEEK_API_KEY / QIANFAN_API_KEY(文心一言)
#    / NEWAPI_API_KEY(newapi 聚合网关)）
# 国产大模型均为 OpenAI 兼容接口，LLM_BASE_URL 可留空（自动按 provider 解析）
LLM_FALLBACK_CHAIN=anthropic:claude-3-5-sonnet,zhipu:glm-4.6,deepseek:deepseek-chat
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
ZHIPU_API_KEY=xxx
# 国产大模型（按需启用，留空即不装载）
DASHSCOPE_API_KEY=sk-xxx        # 通义千问 / 阿里云百炼
DEEPSEEK_API_KEY=sk-xxx         # DeepSeek
QIANFAN_API_KEY=xxx             # 文心一言 / 百度智能云千帆
NEWAPI_API_KEY=sk-xxx           # newapi 聚合网关（https://api.hcnsec.cn）

# === P7: 多模型分工（借鉴 OpenDeepResearch configuration.py）===
# 不同任务用不同模型以平衡成本与质量；空值时全部回退到 LLM_MODEL（向后兼容）
# 格式："provider:model"，例如 "openai:gpt-4o-mini"
#   - LLM_MODEL_ROUTER:      意图分类（router_node），调一次 LLM 返回 JSON，用便宜模型即可
#   - LLM_MODEL_SUMMARIZER:  摘要/记忆压缩（episodic._summarize_turn），用便宜模型
#   - LLM_MODEL_RESPOND:     主响应生成（agent_node / user_confirm_node），需要质量，用强模型
LLM_MODEL_ROUTER=
LLM_MODEL_SUMMARIZER=
LLM_MODEL_RESPOND=

# === MCP Server ===
# MCP_SERVER_PORT: 应用监听端口（config.py 读取，与 Dockerfile / entrypoint 一致）
MCP_SERVER_PORT=8000
# MCP_HOST_PORT: docker-compose 宿主机映射端口（仅 docker-compose.yml 使用，
#   "${MCP_HOST_PORT:-8000}:8000"）。与 MCP_SERVER_PORT 是不同概念：
#   前者是宿主机暴露端口，后者是容器内应用监听端口，两者通常相等。
MCP_HOST_PORT=8000

# === Checkpointer（LangGraph 状态持久化，空则用内存）===
CHECKPOINT_DB_PATH=data/checkpoints.db

# === 主数据库（企业级扩展④：PostgreSQL + SQLAlchemy async）===
# 留空时所有现有文件存储原样工作（零侵入优雅降级）；配置后 DB 层激活并支持双写迁移
# 推荐格式：postgresql+asyncpg://user:pass@host:5432/deadman
# docker compose --profile db 启动时配置为：
#   DATABASE_URL=postgresql+asyncpg://deadman:deadman@deadman-db:5432/deadman
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
# PostgreSQL 容器初始化（profile=db 时使用）
DEADMAN_DB_USER=deadman
DEADMAN_DB_PASSWORD=deadman
DEADMAN_DB_NAME=deadman
DEADMAN_DB_HOST_PORT=5432

# === Docker 沙箱（工具隔离执行，需要 Docker daemon）===
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=30
SANDBOX_WORK_DIR=/tmp/deadman-sandbox

# === 可观测性（profile=observability/full 时生效）===
OTEL_ENDPOINT=http://otel-collector:4317
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# Langfuse 内部依赖（首次部署务必改为随机长字符串）
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me-to-32-plus-random-chars
LANGFUSE_SALT=change-me-to-32-plus-random-chars
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# === Sentry 错误监控（P1-2：DSN 留空时降级为本地日志，生产必配）===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 事务采样率（0=关闭性能监控，1=全量；生产建议 0.1~0.3）
SENTRY_TRACES_SAMPLE_RATE=0.1
# 发布版本（CI 建议注入语义版本或 git SHA，留空则由 SDK 自动推断）
SENTRY_RELEASE=

# === A2A（跨智能体协作）===
A2A_REGISTRY_URL=
A2A_SELF_AGENT_ID=deadman

# === Graphiti / Neo4j（profile=graphiti/full 时生效）===
GRAPHITI_ENABLED=false
# 本地开发默认 bolt://localhost:7687（与 config.py 一致）；docker 环境由 compose 覆盖为 bolt://neo4j:7687
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=changeme

# === LightRAG ===
LIGHTRAG_ENABLED=false

# === Reflexion / SelfCheck ===
REFLEXION_MAX_RETRIES=3
SELFCHECK_CONSISTENCY_THRESHOLD=0.5

# === 日志与严格校验 ===
# DEADMAN_LOG_LEVEL: 结构化日志级别（logging_config.py 读取；兼容旧版 LOG_LEVEL 别名）
DEADMAN_LOG_LEVEL=INFO
STRICT_ENV_CHECK=false

# === 消息平台 Gateway / 主动通知护栏（notification-guardrails.md L4）===
# Telegram Bot API token，从 @BotFather 获取；留空则 TelegramConnector 优雅降级（不拉取消息）
DEADMAN_TELEGRAM_BOT_TOKEN=
# Gateway 总开关，默认 false；改 true 后 entrypoint 会自动启 gateway
DEADMAN_GATEWAY_ENABLED=false
# 主动通知护栏数据目录：consent.json / unsubscribes.json / sent_log.json / last_session.json
DEADMAN_NOTIFICATION_DATA_DIR=~/.deadman/notifications

# === 用户认证与会话（Phase 8，遵守 legal-compliance-framework PIPL）===
# 用户数据目录：users.json + jwt_secret
# 默认 ~/.deadman/auth/，生产环境建议挂载到持久化卷
DEADMAN_AUTH_DATA_DIR=~/.deadman/auth
# JWT 签名密钥（留空则自动生成并持久化到 $DEADMAN_AUTH_DATA_DIR/jwt_secret）
# 生产环境强烈建议通过环境变量显式注入，避免单机密钥漂移；
# 一旦更换，所有已签发的 token 立即失效
DEADMAN_JWT_SECRET=
# JWT 过期天数，默认 7 天
DEADMAN_JWT_EXPIRY_DAYS=7
# 密码最小长度（PBKDF2-HMAC-SHA256，100000 iterations）
DEADMAN_PASSWORD_MIN_LENGTH=8

# === Phase 14/15：加密与多模块（per-user passphrase）===
# 终活笔记加密口令（留空则用开发默认值并打印警告；生产必须设置）
# per-user passphrase 通过 HMAC-SHA256(global_secret, user_id) 派生
DEADMAN_ENDING_NOTE_PASSPHRASE=
# 数字遗产保险库加密口令（同上，独立配置避免单点泄露）
DEADMAN_VAULT_PASSWORD=
# Dead Man Switch 状态机数据目录（注意：实际目录名 deadman_switch）
DEADMAN_SWITCH_DATA_DIR=~/.deadman/deadman_switch
# 客服工单数据目录
DEADMAN_SUPPORT_DATA_DIR=~/.deadman/support
# Onboarding 向导数据目录
DEADMAN_ONBOARDING_DATA_DIR=~/.deadman/onboarding

# === Phase 14 P0-gap-2：ending-note auth 穿透开发期降级 ===
# 默认 0：ending-note 端点强制走 JWT 认证（生产值）
# 设为 1：允许从 query string 取 user_id（仅开发期联调用，生产禁用）
DEADMAN_ALLOW_QUERY_USER_ID=0

# === Phase 16B：微信公众号 Gateway ===
# 微信公众号 AppID（留空则 WeChatConnector 优雅降级）
DEADMAN_WECHAT_APP_ID=
# 微信公众号 AppSecret
DEADMAN_WECHAT_APP_SECRET=
# 微信公众号 webhook 校验 token（微信公众号后台配置）
DEADMAN_WECHAT_VERIFY_TOKEN=

# === Phase 16B：Web 搜索 provider ===
# 支持：duckduckgo（默认）/ baidu / bing-cn
WEB_SEARCH_PROVIDER=duckduckgo

# === Phase 16A：知识库时效巡检 cron ===
# 知识库根目录（包含 regions/ 子目录）
DEADMAN_KNOWLEDGE_DIR=src/knowledge
# 巡检阈值：超过 N 天标记为 stale（默认 180）
DEADMAN_KNOWLEDGE_STALE_DAYS=180
# 巡检阈值：超过 N 天标记为 warning（仅针对政策变更高发领域，默认 90）
DEADMAN_KNOWLEDGE_WARNING_DAYS=90

# === 邮件通知（Dead Man Switch 状态变更通知律师/继承人/紧急联系人）===
# 留空 DEADMAN_SMTP_HOST 则 EmailSender 优雅降级为 mock（不实际发送，
# 仅记录 pending 待办）；配置后用 aiosmtplib 异步发送。
# 生产环境建议使用专用事务邮件服务（如 SES / Mailgun / 阿里云邮件推送）。
DEADMAN_SMTP_HOST=
DEADMAN_SMTP_PORT=587
DEADMAN_SMTP_USER=
DEADMAN_SMTP_PASSWORD=
DEADMAN_SMTP_FROM=noreply@deadman.local
# 是否启用 STARTTLS：1=启用（默认），0=禁用
DEADMAN_SMTP_USE_TLS=1

# =====================================================================
# 补齐 agent-builder-skill 完整版（G1/G2/G3 + 文本处理）
# =====================================================================

# === G3：外部 MCP Server 客户端接入（连接第三方 MCP Server 的工具）===
# JSON 数组，支持 stdio（command+args）/ http（url）/ sse（url，需官方 mcp 包）
# 示例 stdio:  [{"name":"filesystem","transport":"stdio","command":"npx",
#                "args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 示例 http:   [{"name":"weather","transport":"http","url":"http://127.0.0.1:9000/mcp"}]
DEADMAN_MCP_CLIENTS=[]
# 运行时接入的 Server 持久化文件（管理台 /api/mcp 增删时写入）默认 ~/.deadman/mcp_clients.json

# === G2：语音输入输出（/api/voice/*）===
# 单次音频上传上限（MB），默认 20
DEADMAN_VOICE_MAX_UPLOAD_MB=20
# 语音转写/合成依赖多模态管道（DEADMAN_MULTIMODAL_ENABLED=1 且配置任一 ASR/TTS provider）

# === 文本处理（textproc/*）：jieba 中文分词（pip install deadman[text] 可选）===
# 未安装时自动退化单字/词混合分词，关键词/检索算法纯 Python 兜底，始终可用

# === 沙箱绘图（execute_code 图表能力）===
# 本地沙箱：需安装 matplotlib（pip install matplotlib），本机已含。
# Docker 沙箱：SANDBOX_IMAGE 需使用内置 matplotlib 的镜像，例如
#   python:3.12-slim + pip install matplotlib numpy（或改用 mcr 等绘图镜像）

# =====================================================================
# 对话增强（chat_extras）开关与配置
# =====================================================================
# 对话文件上传上限（MB），默认 25
DEADMAN_CHAT_UPLOAD_MB=25
# 沙箱绘图 Docker 镜像（需内置 matplotlib/numpy，见 docker/sandbox/Dockerfile）
# 留空用默认 python:3.12-slim；本地沙箱（SANDBOX_ENABLED=false）用本机 python
SANDBOX_IMAGE=python:3.12-slim
# 导出文件名（/api/chat/export 默认文件名前缀）
# 知识库引用开关在对话界面 📚 按钮；也支持 url 参数 kb=1
